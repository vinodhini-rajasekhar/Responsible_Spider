{
  "name": "spider-xai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "eval": "tsx bench/run.ts",
    "audit": "tsx bench/ai-bot-audit.ts",
    "start": "npm run build && tsx server/index.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "openai": "^7.35.0",
    "robots-parser": "^3.0.1"
  }
}
